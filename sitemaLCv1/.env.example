# ==============================================================================
# SISTEMA LOCAR - MONITORAMENTO DE ROTAS & HEATMAP (SITEMA LC V1)
# ==============================================================================
# Configure suas credenciais da API Inlog (Inlog.Integration.Coleta.Api) abaixo.
# Se deixadas em branco, o sistema executará com dados de simulação locais.

INLOG_BASE_URL=https://api.inlog.com.br
INLOG_CLIENT_ID=seu_client_id_inlog_aqui
INLOG_CLIENT_SECRET=seu_public_token_inlog_aqui
INLOG_SERVER_ID=Inlog.Integration.Coleta.Api

# ==============================================================================
# CONFIGURAÇÕES DO SERVIDOR
# ==============================================================================
PORT=8080
HOST=127.0.0.1
DEBUG=true

# ==============================================================================
# REGRAS OPERACIONAIS DE AUDITORIA LOCAR
# ==============================================================================
# Raio de tolerância do GPS em relação ao eixo da rua (metros)
GPS_BUFFER_METROS=20.0

# Faixa de velocidade considerada para coleta válida (km/h)
VELOCIDADE_MIN_COLETA=2.0
VELOCIDADE_MAX_COLETA=25.0

# Tempo mínimo parado no local para caracterizar coleta manual (segundos)
DWELL_TIME_MIN_SEGUNDOS=180

# direita. A praça escolhida no projeto sai destacada em verde.
#
# Formato:  SLUG = Cidade | UF | CNPJ
# O SLUG também nomeia a logo da prefeitura:
#   dependencias/logos_prefeituras/logo_<SLUG>.png
#
# Transcrito do rodapé de "LICITAÇÃO 24.09.2026/03.Mapas Varrição Manual.pdf"
# em 2026-09-23.
# ⚠ CONFERIR: no PDF de origem, PESQUEIRA repete o CNPJ de SÃO PAULO
# (0003-70) e OLINDA repete o de RECIFE (0004-50). Pode ser erro de
# preenchimento manual do documento original — não foi "corrigido" aqui.
[CONTRATOS_LICITACAO]
sao_paulo               = São Paulo | SP | 35.474.949/0003-70
recife                  = Recife | PE | 35.474.949/0004-50
cabo_de_santo_agostinho	= Cabo de Santo Agostinho | PE | 35.474.949/0011-80

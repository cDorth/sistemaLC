# ── Publicação dos .exe na pasta da operação — build_all.py --publicar ───────
# O .exe é compilado no GitHub Actions (PyInstaller não faz cross-compile) e
# baixado com `--baixar`. O `--publicar` faz o último metro: copia para onde a
# operação vai procurar.
#
# BASE = a pasta compartilhada COMO ELA APARECE NESTA MÁQUINA. No notebook
# Linux é o mount gvfs do OneDrive (cai quando a sessão remota encerra); no
# Windows é a letra de unidade ou o caminho do OneDrive local. Trocar aqui é
# mais simples que passar --destino toda vez.
#
# As demais linhas são a SUBPASTA de cada ferramenta dentro de BASE.
[PUBLICACAO]
base       = /FS - DIE
rotas      = Utilitarios
licitacao  = Licitacao
heatmaps   = Utilitarios
automation = Utilitarios
api        = Utilitarios
giros      = Utilitarios
rascol     = Utilitarios
